# ============================================================
# Parallax — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ----- General -----
APP_ENV=development
DEBUG=true

# ----- Backend / API -----
BACKEND_PORT=8000
SECRET_KEY=change-me-to-a-random-secret
ALLOWED_ORIGINS=http://localhost:3000

# ----- Auth -----
ALLOWED_EMAIL_DOMAINS=diu.edu.bd,daffodilvarsity.edu.bd
AUTH_COOKIE_NAME=parallax_session
# Leave unset to use Secure cookies everywhere except APP_ENV=development.
# COOKIE_SECURE=true
SESSION_TTL_HOURS=12
REMEMBER_ME_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# ----- Database (PostgreSQL) -----
POSTGRES_USER=parallax
POSTGRES_PASSWORD=changeme
POSTGRES_DB=parallax_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ----- AI Service -----
AI_SERVICE_HOST=ai-service
AI_SERVICE_PORT=8001

# ----- Embedding Model -----
# Hugging Face model for multilingual embeddings (Bangla + English)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ----- Redis (caching / task queue) -----
REDIS_HOST=redis
REDIS_PORT=6379

# ----- Frontend -----
# The browser calls /api/v1 on the frontend's own origin; Next.js proxies it to BACKEND_URL,
# so the session cookie belongs to the frontend domain.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_USE_MOCK_AUTH=false
BACKEND_URL=http://backend:8000
