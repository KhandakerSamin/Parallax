# Public URL of this site (used for metadata, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base path of the FastAPI backend as the browser sees it. Keep the default so requests
# stay on this origin and go through the rewrite in next.config.ts.
NEXT_PUBLIC_API_URL=/api/v1

# Where Next.js forwards /api/v1/* (server-side only)
BACKEND_URL=http://localhost:8000

# false = real backend (default). true = built-in mock auth, no backend needed (offline demos).
NEXT_PUBLIC_USE_MOCK_AUTH=false

# Comma-separated email domains allowed to sign up (subdomains are accepted too)
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=diu.edu.bd,daffodilvarsity.edu.bd

# Sign the user out after this many minutes of inactivity
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=30

# Name of the session cookie the proxy checks to guard /dashboard
AUTH_COOKIE_NAME=parallax_session
