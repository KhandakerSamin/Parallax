# Public URL of this site (used for metadata, Open Graph, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth backend (Express/JWT). Ignored while mock auth is on.
NEXT_PUBLIC_API_URL=http://localhost:4000

# true = use the built-in mock auth (no backend needed). Set false to call the real API.
NEXT_PUBLIC_USE_MOCK_AUTH=true

# Comma-separated email domains allowed to sign up (subdomains are accepted too)
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=diu.edu.bd,daffodilvarsity.edu.bd

# Sign the user out after this many minutes of inactivity
NEXT_PUBLIC_IDLE_TIMEOUT_MINUTES=30

# Name of the session cookie the proxy checks to guard /dashboard
AUTH_COOKIE_NAME=parallax_session
